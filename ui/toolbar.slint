import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, Tool, Tip } from "state.slint";
import { IconButton, Divider, VDivider, Segmented, ValueSlider, Toggle, FieldLabel, Card, IconSegmented, IconItem } from "widgets.slint";
import { ComboBox } from "std-widgets.slint";
import { ToolbarSections } from "menus.slint";
import { ToolbarSection } from "widgets.slint";

/// The command palette button: a gradient ring that spins and glows on hover.
export component PaletteButton inherits Rectangle {
    property <bool> hover: ta.has-hover;
    property <angle> spin: 135deg;
    width: 46px;
    height: 32px;
    border-radius: 10px;
    background: @linear-gradient(root.spin, Theme.brand-1 0%, Theme.brand-2 45%, Theme.brand-3 100%);
    drop-shadow-blur: hover ? 16px : 4px;
    drop-shadow-color: hover ? Theme.brand-2.with-alpha(0.7) : Theme.brand-2.with-alpha(0.25);
    animate drop-shadow-blur, drop-shadow-color { duration: 180ms; easing: ease-out; }
    Timer {
        interval: 16ms;
        running: root.hover;
        triggered => { root.spin += 4deg; }
    }
    inner := Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: 8px;
        background: root.hover ? #ffffff00 : Theme.surface;
        animate background { duration: 180ms; }
        Image {
            source: Icons.command;
            width: 16px;
            height: 16px;
            colorize: root.hover ? #ffffff : Theme.accent;
            transform-rotation: root.hover ? 90deg : 0deg;
            animate transform-rotation { duration: 260ms; easing: ease-out; }
            animate colorize { duration: 180ms; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Tip.hide();
            App.action("palette.open");
        }
        changed has-hover => {
            if self.has-hover {
                Tip.show(@tr("Command palette") + "  ·  Space", root.absolute-position.x - 50px, root.absolute-position.y + root.height + 6px);
            } else {
                Tip.hide();
            }
        }
    }
}

export component TopBar inherits Rectangle {
    height: 54px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: 28px;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 7px;
                background: @linear-gradient(135deg, Theme.brand-1 0%, Theme.brand-2 55%, Theme.brand-3 100%);
                Image {
                    source: Icons.brush;
                    width: 14px;
                    height: 14px;
                    colorize: #ffffff;
                }
            }
        }
        VDivider { height: 30px; y: 12px; }
        ToolbarSection {
            title: @tr("File");
            HorizontalLayout {
                spacing: 1px;
                IconButton { icon: Icons.file-plus; tip: @tr("New image") + "  ·  Ctrl+N"; clicked => { App.action("file.new"); } }
                IconButton { icon: Icons.folder-open; tip: @tr("Open") + "  ·  Ctrl+O"; clicked => { App.action("file.open"); } }
                IconButton { icon: Icons.save; tip: @tr("Save") + "  ·  Ctrl+S"; enabled: App.has-doc; clicked => { App.action("file.save"); } }
            }
        }
        VDivider { height: 30px; y: 12px; }
        ToolbarSection {
            title: @tr("Edit");
            HorizontalLayout {
                spacing: 1px;
                IconButton { icon: Icons.undo; tip: @tr("Undo") + "  ·  Ctrl+Z"; enabled: App.can-undo || App.is-editing; clicked => { App.action("edit.undo"); } }
                IconButton { icon: Icons.redo; tip: @tr("Redo") + "  ·  Ctrl+Y"; enabled: App.can-redo; clicked => { App.action("edit.redo"); } }
                IconButton { icon: Icons.scissors; tip: @tr("Cut") + "  ·  Ctrl+X"; enabled: App.has-doc; clicked => { App.action("edit.cut"); } }
                IconButton { icon: Icons.copy; tip: @tr("Copy") + "  ·  Ctrl+C"; enabled: App.has-doc; clicked => { App.action("edit.copy"); } }
                IconButton { icon: Icons.paste; tip: @tr("Paste") + "  ·  Ctrl+V"; clicked => { App.action("edit.paste"); } }
            }
        }
        if App.has-doc: VDivider { height: 30px; y: 12px; }
        if App.has-doc: ToolbarSections { wide: root.width >= 1480px; }
        VDivider { height: 30px; y: 12px; }
        PaletteButton { y: 11px; }
        IconButton { y: 12px; icon: @image-url("icons/settings.svg"); tip: @tr("Settings") + "  ·  Ctrl+,"; clicked => { App.action("app.settings"); } }
    }
}

component Hint inherits Text {
    color: Theme.text-faint;
    font-size: Theme.font-sm;
    wrap: word-wrap;
}

component OptLabel inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-sm;
    font-weight: 600;
}

/// Options of the current tool, stacked vertically for the left sidebar.
export component ToolOptions inherits Card {
    property <Tool> t: App.tool;
    property <bool> is-select: t == Tool.rect-select || t == Tool.ellipse-select || t == Tool.lasso-select || t == Tool.magic-wand;
    property <bool> has-size: t == Tool.brush || t == Tool.eraser || t == Tool.clone || t == Tool.recolor;
    property <bool> has-aa: t == Tool.brush || t == Tool.eraser || t == Tool.clone || t == Tool.recolor || t == Tool.text || t == Tool.line || t == Tool.shape;
    property <bool> has-blend: t == Tool.brush || t == Tool.pencil || t == Tool.bucket || t == Tool.gradient || t == Tool.text || t == Tool.line || t == Tool.shape;
    property <bool> has-flood: t == Tool.magic-wand || t == Tool.bucket;
    property <string> tool-name: t == Tool.rect-select ? @tr("Rectangle Select") : t == Tool.ellipse-select ? @tr("Ellipse Select") : t == Tool.lasso-select ? @tr("Lasso Select")
        : t == Tool.magic-wand ? @tr("Magic Wand") : t == Tool.move-pixels ? @tr("Move Pixels") : t == Tool.move-selection ? @tr("Move Selection")
        : t == Tool.zoom ? @tr("Zoom") : t == Tool.pan ? @tr("Pan") : t == Tool.bucket ? @tr("Paint Bucket") : t == Tool.gradient ? @tr("Gradient")
        : t == Tool.brush ? @tr("Paintbrush") : t == Tool.eraser ? @tr("Eraser") : t == Tool.pencil ? @tr("Pencil") : t == Tool.picker ? @tr("Color Picker")
        : t == Tool.clone ? @tr("Clone Stamp") : t == Tool.recolor ? @tr("Recolor") : t == Tool.text ? @tr("Text") : t == Tool.line ? @tr("Line / Curve") : @tr("Shapes");
    property <image> tool-icon: t == Tool.rect-select ? Icons.square-dashed : t == Tool.ellipse-select ? Icons.circle-dashed : t == Tool.lasso-select ? Icons.lasso
        : t == Tool.magic-wand ? Icons.wand : t == Tool.move-pixels ? Icons.move : t == Tool.move-selection ? Icons.pointer
        : t == Tool.zoom ? Icons.zoom-in : t == Tool.pan ? Icons.hand : t == Tool.bucket ? Icons.bucket : t == Tool.gradient ? Icons.gradient
        : t == Tool.brush ? Icons.brush : t == Tool.eraser ? Icons.eraser : t == Tool.pencil ? Icons.pencil : t == Tool.picker ? Icons.pipette
        : t == Tool.clone ? Icons.stamp : t == Tool.recolor ? Icons.replace : t == Tool.text ? Icons.type : t == Tool.line ? Icons.spline : Icons.shapes;

    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 7px;
                background: Theme.accent-soft;
                Image {
                    source: root.tool-icon;
                    width: 15px;
                    height: 15px;
                    colorize: Theme.accent;
                }
            }
            Text {
                text: root.tool-name;
                font-size: Theme.font;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.is-select: VerticalLayout {
            spacing: 5px;
            OptLabel { text: @tr("Selection mode"); }
            IconSegmented {
                items: [
                    { icon: Icons.square, tip: @tr("Replace") },
                    { icon: @image-url("icons/squares-unite.svg"), tip: @tr("Add (Ctrl)") },
                    { icon: @image-url("icons/squares-subtract.svg"), tip: @tr("Subtract (Alt)") },
                    { icon: @image-url("icons/squares-intersect.svg"), tip: @tr("Intersect") },
                    { icon: @image-url("icons/squares-exclude.svg"), tip: @tr("Invert overlap") },
                ];
                selected: App.sel-mode;
                changed(i) => { App.sel-mode = i; App.option-changed(); }
            }
        }
        if root.has-size: ValueSlider {
            label: @tr("Size");
            minimum: 1;
            maximum: 500;
            power: 2.5;
            suffix: " px";
            source: App.brush-width;
            edited(v) => { App.brush-width = v; App.option-changed(); }
        }
        if root.t == Tool.brush || root.t == Tool.eraser || root.t == Tool.clone: ValueSlider {
            label: @tr("Hardness");
            minimum: 0;
            maximum: 100;
            suffix: "%";
            source: App.hardness;
            edited(v) => { App.hardness = v; App.option-changed(); }
        }
        if root.t == Tool.shape: ComboBox {
            model: App.shape-names;
            current-index: App.shape-type;
            selected(v) => { App.shape-type = self.current-index; App.option-changed(); }
        }
        if root.t == Tool.line || root.t == Tool.shape: ValueSlider {
            label: root.t == Tool.line ? @tr("Width") : @tr("Outline");
            minimum: 1;
            maximum: 200;
            power: 2;
            suffix: " px";
            source: App.brush-width;
            edited(v) => { App.brush-width = v; App.option-changed(); }
        }
        if root.t == Tool.shape: Segmented {
            items: [@tr("Outline"), @tr("Fill"), @tr("Both")];
            selected: App.fill-style;
            changed(i) => { App.fill-style = i; App.option-changed(); }
        }
        if root.t == Tool.shape && App.shape-type == 1: ValueSlider {
            label: @tr("Corner radius");
            minimum: 0;
            maximum: 200;
            source: App.corner-radius;
            edited(v) => { App.corner-radius = v; App.option-changed(); }
        }
        if root.t == Tool.line: Segmented {
            items: [@tr("Solid"), @tr("Dashed"), @tr("Dotted")];
            selected: App.dash;
            changed(i) => { App.dash = i; App.option-changed(); }
        }
        if root.has-flood: Segmented {
            items: [@tr("Contiguous"), @tr("Global")];
            selected: App.flood-global ? 1 : 0;
            changed(i) => { App.flood-global = i == 1; App.option-changed(); }
        }
        if root.has-flood || root.t == Tool.recolor: ValueSlider {
            label: @tr("Tolerance");
            minimum: 0;
            maximum: 100;
            suffix: "%";
            source: App.tolerance;
            edited(v) => { App.tolerance = v; App.option-changed(); }
        }
        if root.has-flood || root.t == Tool.picker: VerticalLayout {
            spacing: 5px;
            OptLabel { text: @tr("Sample from"); }
            Segmented {
                items: [@tr("Layer"), @tr("Image")];
                selected: App.sample-image ? 1 : 0;
                changed(i) => { App.sample-image = i == 1; App.option-changed(); }
            }
        }
        if root.t == Tool.gradient: ComboBox {
            model: [@tr("Linear"), @tr("Reflected"), @tr("Diamond"), @tr("Radial"), @tr("Conical")];
            current-index: App.gradient-type;
            selected(v) => { App.gradient-type = self.current-index; App.option-changed(); }
        }
        if root.t == Tool.gradient: Segmented {
            items: [@tr("Color"), @tr("Transparency")];
            selected: App.gradient-alpha ? 1 : 0;
            changed(i) => { App.gradient-alpha = i == 1; App.option-changed(); }
        }
        if root.t == Tool.picker: VerticalLayout {
            spacing: 5px;
            OptLabel { text: @tr("Sampling"); }
            Segmented {
                items: [@tr("1 px"), "3×3", "5×5", "9×9"];
                selected: App.picker-size;
                changed(i) => { App.picker-size = i; App.option-changed(); }
            }
        }
        if root.t == Tool.picker: VerticalLayout {
            spacing: 5px;
            OptLabel { text: @tr("After picking"); }
            ComboBox {
                model: [@tr("Stay on picker"), @tr("Previous tool"), @tr("Pencil")];
                current-index: App.picker-after;
                selected(v) => { App.picker-after = self.current-index; }
            }
        }
        if root.t == Tool.text: ComboBox {
            model: App.fonts;
            current-value: App.font-family;
            selected(v) => { App.font-family = v; App.option-changed(); }
        }
        if root.t == Tool.text: ValueSlider {
            label: @tr("Size");
            minimum: 4;
            maximum: 400;
            power: 2;
            suffix: " pt";
            source: App.font-size;
            edited(v) => { App.font-size = v; App.option-changed(); }
        }
        if root.t == Tool.text: HorizontalLayout {
            spacing: 4px;
            Toggle { text: "B"; tip: @tr("Bold"); checked: App.bold; toggled(c) => { App.bold = c; App.option-changed(); } }
            Toggle { text: "I"; tip: @tr("Italic"); checked: App.italic; toggled(c) => { App.italic = c; App.option-changed(); } }
            Toggle { text: "U"; tip: @tr("Underline"); checked: App.underline; toggled(c) => { App.underline = c; App.option-changed(); } }
            Rectangle { horizontal-stretch: 1; }
            IconSegmented {
                items: [
                    { icon: @image-url("icons/text-align-start.svg"), tip: @tr("Align left") },
                    { icon: @image-url("icons/text-align-center.svg"), tip: @tr("Align center") },
                    { icon: @image-url("icons/text-align-end.svg"), tip: @tr("Align right") },
                ];
                selected: App.text-align;
                changed(i) => { App.text-align = i; App.option-changed(); }
            }
        }
        if root.has-aa: HorizontalLayout {
            spacing: 6px;
            Toggle {
                text: @tr("Antialias");
                checked: App.antialias;
                toggled(c) => { App.antialias = c; App.option-changed(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.has-blend: Segmented {
            items: [@tr("Normal"), @tr("Overwrite")];
            selected: App.overwrite ? 1 : 0;
            changed(i) => { App.overwrite = i == 1; App.option-changed(); }
        }
        if root.t == Tool.move-pixels || root.t == Tool.move-selection: Hint { text: @tr("Drag to move. Drag corner handles to scale, right-drag to rotate. Shift constrains."); }
        if root.t == Tool.zoom: Hint { text: @tr("Click to zoom in, right-click to zoom out, drag a rectangle to zoom to it."); }
        if root.t == Tool.pan: Hint { text: @tr("Drag to pan. Middle mouse or holding Space pans with any tool."); }
        if root.t == Tool.clone: Hint { text: @tr("Ctrl+click to set the source, then paint."); }
        if root.is-select: Hint { text: @tr("Hold Ctrl to add, Alt to subtract."); }
        if root.t == Tool.text: Hint { text: @tr("Click to place text. Enter for a new line, Esc to finish."); }
        if root.t == Tool.shape || root.t == Tool.line: Hint { text: @tr("Drag to draw, then adjust with the handles. Shift constrains, Enter finishes."); }
        if root.t == Tool.brush: Hint { text: @tr("Shift+click draws a straight line from the last point. [ and ] change the size."); }
    }
}
