    FieldLabel {
        text: App.export-format == 3 ? @tr("OpenRaster keeps your layers and opens in GIMP, Krita and MyPaint.") : @tr("Layers are flattened in this format.");
        wrap: word-wrap;
    }
    Buttons {
        Btn { text: @tr("Cancel"); clicked => { App.dialog = ""; } }
        Btn { text: @tr("Download"); primary: true; clicked => { App.export-file(App.export-name, App.export-format); } }
    }
}

/// Every language as a chip, each name drawn in a font that has its script.
component LanguageGrid inherits Rectangle {
    property <int> cols: 4;
    property <length> gap: 6px;
    property <length> chip-w: (self.width - (cols - 1) * gap) / cols;
    property <length> chip-h: 30px;
    height: ceil(App.languages.length / cols) * (chip-h + gap) - gap;
    for lang[i] in App.languages: Rectangle {
        property <bool> current: i == App.language-index;
        x: mod(i, root.cols) * (root.chip-w + root.gap);
        y: floor(i / root.cols) * (root.chip-h + root.gap);
        width: root.chip-w;
        height: root.chip-h;
        border-radius: 8px;
        background: current ? Theme.accent-soft : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : Theme.surface-2;
        border-width: 1px;
        border-color: current ? Theme.accent : Theme.border;
        animate background, border-color { duration: 90ms; }
        Text {
            text: lang.name;
            font-family: lang.font;
            font-size: 12.5px;
            font-weight: current ? 600 : 400;
            color: current ? Theme.text : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            width: parent.width - 8px;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.set-language(i); }
        }
    }
}

component AccentSwatch inherits Rectangle {
    in property <brush> fill;
    in property <bool> selected;
    in property <string> name;
    in property <image> icon;
    callback picked();
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: root.fill;
    border-width: selected ? 3px : 0px;
    border-color: Theme.text;
    drop-shadow-blur: ta.has-hover || selected ? 10px : 0px;
    drop-shadow-color: Theme.shadow;
    animate drop-shadow-blur { duration: 120ms; }
    if root.icon.width > 0: Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: #ffffff;
    }
    if root.selected && root.icon.width == 0: Image {
        source: Icons.check;
        width: 18px;
        height: 18px;
        colorize: #ffffff;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
        changed has-hover => {
            if self.has-hover {
                Tip.show(root.name, root.absolute-position.x, root.absolute-position.y + root.height + 6px);
            } else {
                Tip.hide();
            }
        }
    }
}

export component SettingsDialog inherits Overlay {
    title: @tr("Settings");
    icon: @image-url("icons/settings.svg");
    card-width: 460px;
    close => { App.dialog = ""; }
    FieldLabel { text: @tr("Language"); }
    LanguageGrid { }
    FieldLabel { text: @tr("Theme"); }
    Segmented {
        items: [@tr("Follow system"), @tr("Light"), @tr("Dark")];
        selected: App.theme-mode;
        changed(i) => {
            App.action(i == 0 ? "view.theme-system" : i == 1 ? "view.theme-light" : "view.theme-dark");
        }
    }
    FieldLabel { text: @tr("Accent color"); }
    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        AccentSwatch { name: @tr("Violet"); fill: @linear-gradient(135deg, #a78bfa 0%, #6a4cf5 100%); selected: Theme.accent-scheme == 0; picked => { App.set-accent(0); } }
        AccentSwatch { name: @tr("Blue"); fill: @linear-gradient(135deg, #7dd3fc 0%, #2563eb 100%); selected: Theme.accent-scheme == 1; picked => { App.set-accent(1); } }
        AccentSwatch { name: @tr("Teal"); fill: @linear-gradient(135deg, #5eead4 0%, #0d9488 100%); selected: Theme.accent-scheme == 2; picked => { App.set-accent(2); } }
        AccentSwatch { name: @tr("Orange"); fill: @linear-gradient(135deg, #fdba74 0%, #ea580c 100%); selected: Theme.accent-scheme == 3; picked => { App.set-accent(3); } }
        AccentSwatch { name: @tr("Rose"); fill: @linear-gradient(135deg, #fda4af 0%, #e11d48 100%); selected: Theme.accent-scheme == 4; picked => { App.set-accent(4); } }
        AccentSwatch {
            name: @tr("Halloween");
            fill: @linear-gradient(135deg, #ff9a1f 0%, #ff6a00 45%, #5b1a7a 100%);
            icon: @image-url("icons/ghost.svg");
            selected: Theme.accent-scheme == 5;
            picked => { App.set-accent(5); }
        }
    }
    if Theme.halloween: FieldLabel {
        text: @tr("Happy Halloween! This theme is always dark.");
        wrap: word-wrap;
    }
    Buttons {
        Btn { text: @tr("Done"); primary: true; clicked => { App.dialog = ""; } }
    }
}
