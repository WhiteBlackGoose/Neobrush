import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, ParamItem, Tip } from "state.slint";
import { Card, IconButton, Btn, Segmented, ValueSlider, FieldLabel, Divider } from "widgets.slint";
import { ShortcutsList } from "palette.slint";
import { SpinBox, CheckBox, ComboBox, LineEdit, Spinner, AboutSlint } from "std-widgets.slint";

component Overlay inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <length> card-width: 380px;
    in property <bool> dim: true;
    in property <bool> docked: false;
    callback close();
    background: dim ? Theme.backdrop : transparent;
    TouchArea { }
    card := Card {
        width: root.card-width;
        height: layout.preferred-height;
        x: root.docked ? parent.width - self.width - 300px : (parent.width - self.width) / 2;
        y: root.docked ? 104px : max(20px, (parent.height - self.height) / 2 - 20px);
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 8px;
        border-radius: 14px;
        layout := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                if root.icon.width > 0: Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 8px;
                    background: Theme.accent-soft;
                    Image {
                        source: root.icon;
                        width: 16px;
                        height: 16px;
                        colorize: Theme.accent;
                    }
                }
                Text {
                    text: root.title;
                    font-size: Theme.font-lg;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                IconButton {
                    size: 28px;
                    icon: Icons.x;
                    clicked => { root.close(); }
                }
            }
            @children
        }
    }
}

component Buttons inherits HorizontalLayout {
    spacing: 8px;
    alignment: end;
    padding-top: 6px;
}

component Chip inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 26px;
    width: t.preferred-width + 18px;
    border-radius: 13px;
    background: ta.has-hover ? Theme.surface-3 : Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;
    t := Text {
        text: root.text;
        font-size: Theme.font-sm + 0.5px;
        color: Theme.text;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component NewImageDialog inherits Overlay {
    title: @tr("New Image");
    icon: Icons.file-plus;
    card-width: 420px;
    property <int> w: App.image-w;
    property <int> h: App.image-h;
    property <bool> keep: false;
    property <int> bg: 0;
    close => { App.dialog = ""; }
    GridLayout {
        spacing: 10px;
        Row {
            FieldLabel { text: @tr("Width"); }
            SpinBox {
                minimum: 1;
                maximum: 32000;
                value: root.w;
                edited(v) => {
                    if root.keep && root.w > 0 { root.h = max(1, round(root.h * v / root.w)); }
                    root.w = v;
                }
            }
            FieldLabel { text: "px"; }
        }
        Row {
            FieldLabel { text: @tr("Height"); }
            SpinBox {
                minimum: 1;
                maximum: 32000;
                value: root.h;
                edited(v) => {
                    if root.keep && root.h > 0 { root.w = max(1, round(root.w * v / root.h)); }
                    root.h = v;
                }
            }
            FieldLabel { text: "px"; }
        }
    }
    CheckBox {
        text: @tr("Maintain aspect ratio");
        checked <=> root.keep;
    }
    FieldLabel { text: @tr("Presets"); }
    VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            if App.clip-w > 0: Chip { text: @tr("Clipboard {}×{}", App.clip-w, App.clip-h); clicked => { root.w = App.clip-w; root.h = App.clip-h; } }
            Chip { text: "1920×1080"; clicked => { root.w = 1920; root.h = 1080; } }
            Chip { text: "1280×720"; clicked => { root.w = 1280; root.h = 720; } }
            Chip { text: "1080×1080"; clicked => { root.w = 1080; root.h = 1080; } }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Chip { text: "800×600"; clicked => { root.w = 800; root.h = 600; } }
            Chip { text: "512×512"; clicked => { root.w = 512; root.h = 512; } }
            Chip { text: @tr("A4 @300dpi"); clicked => { root.w = 2480; root.h = 3508; } }
            Chip { text: "3840×2160"; clicked => { root.w = 3840; root.h = 2160; } }
        }
    }
    FieldLabel { text: @tr("Background"); }
    Segmented {
        items: [@tr("White"), @tr("Transparent"), @tr("Secondary color")];
        selected <=> root.bg;
    }
    Buttons {
        Btn { text: @tr("Cancel"); clicked => { App.dialog = ""; } }
        Btn { text: @tr("Create"); primary: true; clicked => { App.new-image(root.w, root.h, root.bg); } }
    }
}

export component ResizeDialog inherits Overlay {
    title: @tr("Resize Image");
    icon: Icons.scaling;
    card-width: 420px;
    property <int> mode: 0;
    property <float> pct: 100;
    property <int> w: App.image-w;
    property <int> h: App.image-h;
    property <bool> keep: true;
    property <int> resample: 0;
    close => { App.dialog = ""; }
    Segmented {
        items: [@tr("By percentage"), @tr("By absolute size")];
        selected <=> root.mode;
    }
    if root.mode == 0: ValueSlider {
        label: @tr("Percentage");
        minimum: 1;
        maximum: 400;
        suffix: "%";
        source: root.pct;
        edited(v) => {
            root.pct = v;
            root.w = max(1, round(App.image-w * v / 100));
            root.h = max(1, round(App.image-h * v / 100));
        }
    }
    GridLayout {
        spacing: 10px;
        Row {
            FieldLabel { text: @tr("Width"); }
            SpinBox {
                enabled: root.mode == 1;
                minimum: 1;
                maximum: 32000;
                value: root.w;
                edited(v) => {
                    root.w = v;
                    if root.keep { root.h = max(1, round(v * App.image-h / App.image-w)); }
                }
            }
            FieldLabel { text: "px"; }
        }
        Row {
            FieldLabel { text: @tr("Height"); }
            SpinBox {
                enabled: root.mode == 1;
                minimum: 1;
                maximum: 32000;
                value: root.h;
                edited(v) => {
                    root.h = v;
                    if root.keep { root.w = max(1, round(v * App.image-w / App.image-h)); }
                }
            }
            FieldLabel { text: "px"; }
        }
    }
    CheckBox {
        text: @tr("Maintain aspect ratio");
        checked <=> root.keep;
    }
    HorizontalLayout {
        spacing: 10px;
        FieldLabel { text: @tr("Resampling"); }
        ComboBox {
            model: [@tr("Best quality"), @tr("Bicubic"), @tr("Bilinear"), @tr("Nearest neighbor")];
            current-index <=> root.resample;
        }
    }
    FieldLabel {
        text: @tr("Original: {} × {} px  →  New: {} × {} px", App.image-w, App.image-h, root.w, root.h);
    }
    Buttons {
        Btn { text: @tr("Cancel"); clicked => { App.dialog = ""; } }
        Btn { text: @tr("Resize"); primary: true; clicked => { App.resize-image(root.w, root.h, root.resample); } }
    }
}

export component CanvasSizeDialog inherits Overlay {
    title: @tr("Canvas Size");
    icon: Icons.frame;
    card-width: 420px;
    property <int> w: App.image-w;
    property <int> h: App.image-h;
    property <bool> keep: false;
    property <int> anchor: 4;
    close => { App.dialog = ""; }
    HorizontalLayout {
        spacing: 20px;
        VerticalLayout {
            spacing: 10px;
            GridLayout {
                spacing: 10px;
                Row {
                    FieldLabel { text: @tr("Width"); }
                    SpinBox {
                        minimum: 1;
                        maximum: 32000;
                        value: root.w;
                        edited(v) => {
                            root.w = v;
                            if root.keep { root.h = max(1, round(v * App.image-h / App.image-w)); }
                        }
                    }
                }
                Row {
                    FieldLabel { text: @tr("Height"); }
                    SpinBox {
                        minimum: 1;
                        maximum: 32000;
                        value: root.h;
                        edited(v) => {
                            root.h = v;
                            if root.keep { root.w = max(1, round(v * App.image-w / App.image-h)); }
                        }
                    }
                }
            }
            CheckBox {
                text: @tr("Maintain aspect ratio");
                checked <=> root.keep;
            }
        }
        VerticalLayout {
            spacing: 6px;
            FieldLabel { text: @tr("Anchor"); }
            GridLayout {
                spacing: 4px;
                for i in 9: Rectangle {
                    row: floor(i / 3);
                    col: mod(i, 3);
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: i == root.anchor ? Theme.accent : (ata.has-hover ? Theme.surface-3 : Theme.surface-2);
                    border-width: 1px;
                    border-color: Theme.border;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: i == root.anchor ? #ffffff : Theme.text-faint;
                    }
                    ata := TouchArea {
                        clicked => { root.anchor = i; }
                    }
                }
            }
        }
    }
    Buttons {
        Btn { text: @tr("Cancel"); clicked => { App.dialog = ""; } }
        Btn { text: @tr("Apply"); primary: true; clicked => { App.canvas-resize(root.w, root.h, root.anchor); } }
    }
}

export component FxDialog inherits Overlay {
    title: App.fx-title;
    icon: Icons.sparkles;
    card-width: 340px;
    dim: false;
    docked: true;
    close => { App.fx-cancel(); }
    for p[i] in App.fx-params: VerticalLayout {
        if p.kind == 0: ValueSlider {
            label: p.label;
            minimum: p.min;
            maximum: p.max;
            step: p.step;
            decimals: p.decimals;
            source: p.value;
            edited(v) => { App.fx-param(i, v); }
        }
        if p.kind == 1: CheckBox {
            text: p.label;
            checked: p.value > 0.5;
            toggled => { App.fx-param(i, self.checked ? 1 : 0); }
        }
        if p.kind == 2: HorizontalLayout {
            spacing: 10px;
            FieldLabel { text: p.label; }
            ComboBox {
                model: p.choices;
                current-index: p.value;
                selected(v) => { App.fx-param(i, self.current-index); }
            }
        }
    }
    Buttons {
        if App.fx-busy: Spinner {
            indeterminate: true;
            width: 22px;
            height: 22px;
            y: 5px;
        }
        Rectangle { horizontal-stretch: 1; }
        Btn { text: @tr("Reset"); clicked => { App.fx-reset(); } }
        Btn { text: @tr("Cancel"); clicked => { App.fx-cancel(); } }
        Btn { text: @tr("Apply"); primary: true; clicked => { App.fx-ok(); } }
    }
}

export component CurvesDialog inherits Overlay {
    title: @tr("Curves");
    icon: Icons.squiggle;
    card-width: 300px;
    dim: false;
    docked: true;
    close => { App.fx-cancel(); }
    Segmented {
        items: [@tr("RGB"), @tr("Red"), @tr("Green"), @tr("Blue")];
        selected: App.curve-channel;
        changed(i) => {
            App.curve-channel = i;
            App.curve-channel-changed();
        }
    }
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 256px;
            height: 256px;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 4px;
            for i in 3: Rectangle {
                x: (i + 1) * 64px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }
            for i in 3: Rectangle {
                y: (i + 1) * 64px;
                x: 0;
                height: 1px;
                width: parent.width;
                background: Theme.border;
            }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 256;
                viewbox-height: 256;
                commands: App.curve-path-faint;
                stroke: Theme.text-faint;
                stroke-width: 1px;
            }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 256;
                viewbox-height: 256;
                commands: App.curve-path;
                stroke: App.curve-channel == 1 ? #ef4444 : App.curve-channel == 2 ? #22c55e : App.curve-channel == 3 ? #3b82f6 : Theme.text;
                stroke-width: 2px;
            }
            for p in App.curve-points: Rectangle {
                x: p.x * 1px - 5px;
                y: (255 - p.y) * 1px - 5px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: #ffffff;
                border-width: 2px;
                border-color: Theme.accent;
            }
            TouchArea {
                mouse-cursor: crosshair;
                pointer-event(e) => {
                    App.curve-pointer(
                        e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 1 : e.kind == PointerEventKind.move ? 2 : 3,
                        e.button == PointerEventButton.left ? 0 : e.button == PointerEventButton.right ? 1 : 2,
                        self.mouse-x / 1px, 255 - self.mouse-y / 1px);
                }
            }
        }
    }
    FieldLabel {
        text: @tr("Click to add points · drag to move · right-click to remove");
        wrap: word-wrap;
    }
    Buttons {
        Btn { text: @tr("Reset"); clicked => { App.curve-reset(); } }
        Btn { text: @tr("Cancel"); clicked => { App.fx-cancel(); } }
        Btn { text: @tr("Apply"); primary: true; clicked => { App.fx-ok(); } }
    }
}

export component LayerPropsDialog inherits Overlay {
    title: @tr("Layer Properties");
    icon: Icons.layers;
    card-width: 340px;
    dim: false;
    docked: true;
    property <string> name: App.lp-name;
    property <bool> vis: App.lp-visible;
    property <int> blend: App.lp-blend;
    property <float> op: App.lp-opacity;
    close => { App.layer-props-cancel(); }
    function push() {
        App.layer-props(root.name, root.vis, root.blend, root.op);
    }
    HorizontalLayout {
        spacing: 10px;
        FieldLabel { text: @tr("Name"); width: 60px; }
        LineEdit {
            text: root.name;
            changed has-focus => { App.text-focus = self.has-focus; }
            edited(t) => {
                root.name = t;
                root.push();
            }
        }
    }
    CheckBox {
        text: @tr("Visible");
        checked: root.vis;
        toggled => {
            root.vis = self.checked;
            root.push();
        }
    }
    HorizontalLayout {
        spacing: 10px;
        FieldLabel { text: @tr("Blend mode"); width: 60px; }
        ComboBox {
            model: App.blend-modes;
            current-index: root.blend;
            selected(v) => {
                root.blend = self.current-index;
                root.push();
            }
        }
    }
    ValueSlider {
        label: @tr("Opacity");
        minimum: 0;
        maximum: 255;
        source: root.op;
        edited(v) => {
            root.op = v;
            root.push();
        }
    }
    Buttons {
        Btn { text: @tr("Cancel"); clicked => { App.layer-props-cancel(); } }
        Btn { text: @tr("OK"); primary: true; clicked => { App.layer-props-ok(); } }
    }
}

export component ConfirmDialog inherits Overlay {
    title: @tr("Unsaved changes");
    icon: Icons.alert;
    card-width: 440px;
    close => { App.confirm(1); }
    Text {
        text: @tr("Save changes to “{}” before closing?", App.confirm-doc);
        color: Theme.text;
        font-size: Theme.font + 1px;
        wrap: word-wrap;
    }
    Text {
        text: @tr("Your changes will be lost if you don't save them.");
        color: Theme.text-muted;
        font-size: Theme.font;
        wrap: word-wrap;
    }
    Buttons {
        Btn { text: @tr("Don't Save"); clicked => { App.confirm(0); } }
        Rectangle { horizontal-stretch: 1; }
        Btn { text: @tr("Cancel"); clicked => { App.confirm(1); } }
        Btn { text: @tr("Save"); primary: true; clicked => { App.confirm(2); } }
    }
}

export component MessageDialog inherits Overlay {
    title: App.message-title;
    icon: Icons.info;
    card-width: 420px;
    close => { App.dialog = ""; }
    Text {
        text: App.message-text;
        color: Theme.text;
        font-size: Theme.font;
        wrap: word-wrap;
    }
    Buttons {
        Btn { text: @tr("OK"); primary: true; clicked => { App.dialog = ""; } }
    }
}

export component JpegDialog inherits Overlay {
    title: @tr("Save Configuration");
    icon: Icons.image-down;
    card-width: 360px;
    close => { App.dialog = ""; }
    ValueSlider {
        label: @tr("Quality");
        minimum: 1;
        maximum: 100;
        source: App.jpeg-quality;
        edited(v) => { App.jpeg-quality = v; }
    }
    FieldLabel {
        text: @tr("Higher quality means larger files. Transparency is flattened onto white.");
        wrap: word-wrap;
    }
    Buttons {
        Btn { text: @tr("Cancel"); clicked => { App.dialog = ""; } }
