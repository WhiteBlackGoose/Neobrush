}

export component AboutDialog inherits Overlay {
    title: @tr("About");
    card-width: 400px;
    close => { App.dialog = ""; }
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            background: @linear-gradient(135deg, Theme.brand-1 0%, Theme.brand-2 55%, Theme.brand-3 100%);
            Image {
                source: Icons.brush;
                width: 32px;
                height: 32px;
                colorize: #ffffff;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: "Neobrush";
                font-size: 20px;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: @tr("Version {}", App.version);
                color: Theme.text-muted;
                font-size: Theme.font;
            }
        }
    }
    Text {
        text: @tr("A modern, cross-platform raster graphics editor for Windows, macOS, Linux and FreeBSD.");
        color: Theme.text;
        font-size: Theme.font;
        wrap: word-wrap;
    }
    AboutSlint {
        height: 90px;
    }
    Text {
        text: @tr("Icons by Lucide (ISC). Inter typeface (OFL).");
        color: Theme.text-muted;
        font-size: Theme.font-sm + 0.5px;
        wrap: word-wrap;
    }
    Buttons {
        Btn { text: @tr("Close"); primary: true; clicked => { App.dialog = ""; } }
    }
}

export component ShortcutsDialog inherits Overlay {
    title: @tr("Keyboard Shortcuts");
    icon: Icons.keyboard;
    card-width: 640px;
    close => { App.dialog = ""; }
    Text {
        text: @tr("Purple keys are chords: press them one after another (e.g. F, then B, then G). Tap Space for the command palette; hold Space to pan.");
        color: Theme.text-muted;
        font-size: Theme.font;
        wrap: word-wrap;
    }
    ShortcutsList {
        height: min(520px, root.height - 220px);
    }
    Buttons {
        Btn { text: @tr("Close"); primary: true; clicked => { App.dialog = ""; } }
    }
}

export component ExportDialog inherits Overlay {
    title: @tr("Save As");
    icon: Icons.image-down;
    card-width: 440px;
    close => { App.dialog = ""; }
    HorizontalLayout {
        spacing: 10px;
        FieldLabel { text: @tr("File name"); width: 70px; }
        LineEdit {
            text <=> App.export-name;
            changed has-focus => { App.text-focus = self.has-focus; }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        FieldLabel { text: @tr("Format"); width: 70px; }
        Segmented {
            items: [@tr("PNG"), @tr("JPEG"), @tr("WebP"), @tr("OpenRaster"), @tr("BMP")];
            selected <=> App.export-format;
        }
