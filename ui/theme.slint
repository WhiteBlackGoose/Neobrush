import { Palette } from "std-widgets.slint";

export global Theme {
    /// 0 violet, 1 blue, 2 teal, 3 orange, 4 rose, 5 halloween
    in-out property <int> accent-scheme: 0;
    out property <bool> halloween: accent-scheme == 5;
    // "Follow system" sets the scheme to unknown; the style then picks the system scheme
    // internally, which shows up in its background color.
    out property <bool> dark: halloween || Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme == ColorScheme.unknown && Palette.background.to-hsv().value < 0.5);

    out property <color> bg: halloween ? #110a13 : dark ? #121216 : #eef0f4;
    out property <color> surface: halloween ? #1b1020 : dark ? #1b1b21 : #ffffff;
    out property <color> surface-2: halloween ? #24152a : dark ? #23232b : #f5f6f9;
    out property <color> surface-3: halloween ? #2f1c36 : dark ? #2c2c36 : #eaecf1;
    out property <color> hover: dark ? #ffffff10 : #0000000a;
    out property <color> pressed: dark ? #ffffff1c : #00000014;
    out property <color> border: halloween ? #3a2342 : dark ? #2b2b34 : #e2e4ea;
    out property <color> border-strong: halloween ? #4a2d54 : dark ? #3a3a46 : #cfd2da;
    out property <color> canvas-bg: halloween ? #0a050c : dark ? #0d0d10 : #e3e5ea;
    out property <color> text: halloween ? #f7ecff : dark ? #ececf2 : #1a1b22;
    out property <color> text-muted: halloween ? #b8a3c4 : dark ? #9a9aab : #646778;
    out property <color> text-faint: halloween ? #7e6889 : dark ? #6a6a7a : #9a9daa;

    out property <color> accent: accent-scheme == 1 ? (dark ? #4c9dff : #1f6fe5)
        : accent-scheme == 2 ? (dark ? #2dd4bf : #0d9488)
        : accent-scheme == 3 ? (dark ? #ff9a3d : #e8710a)
        : accent-scheme == 4 ? (dark ? #fb7185 : #e11d48)
        : accent-scheme == 5 ? #ff7a1a
        : (dark ? #8b74ff : #6a4cf5);
    out property <color> accent-hover: dark ? accent.brighter(0.12) : accent.darker(0.12);
    out property <color> accent-soft: accent.with-alpha(dark ? 0.2 : 0.13);
    out property <color> accent-text: #ffffff;

    // Brand gradient (logo, palette button, welcome screen).
    out property <color> brand-1: accent-scheme == 1 ? #7dd3fc : accent-scheme == 2 ? #5eead4 : accent-scheme == 3 ? #fdba74 : accent-scheme == 4 ? #fda4af : accent-scheme == 5 ? #ffb347 : #a78bfa;
    out property <color> brand-2: accent-scheme == 1 ? #2563eb : accent-scheme == 2 ? #0d9488 : accent-scheme == 3 ? #ea580c : accent-scheme == 4 ? #e11d48 : accent-scheme == 5 ? #ff6a00 : #6a4cf5;
    out property <color> brand-3: accent-scheme == 1 ? #8b5cf6 : accent-scheme == 2 ? #2563eb : accent-scheme == 3 ? #db2777 : accent-scheme == 4 ? #9333ea : accent-scheme == 5 ? #7e22ce : #ec4899;

    out property <color> danger: dark ? #ff6b7a : #d83a4c;
    out property <color> shadow: dark ? #00000080 : #1a1b2224;
    out property <color> backdrop: dark ? #000000a0 : #1a1b2266;

    out property <length> radius: 10px;
    out property <length> radius-sm: 6px;
    out property <length> font-sm: 11px;
    out property <length> font: 12.5px;
    out property <length> font-lg: 15px;
}
