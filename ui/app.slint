                MenuItem { title: @tr("Glow…") + "      F P G"; activated => { App.action("fx:glow"); } }
                MenuItem { title: @tr("Red Eye Removal…") + "      F P R"; activated => { App.action("fx:red-eye"); } }
                MenuItem { title: @tr("Sharpen…") + "      F P S"; activated => { App.action("fx:sharpen"); } }
                MenuItem { title: @tr("Soft Portrait…") + "      F P P"; activated => { App.action("fx:soft-portrait"); } }
                MenuItem { title: @tr("Vignette…") + "      F P V"; activated => { App.action("fx:vignette"); } }
