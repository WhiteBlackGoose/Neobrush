                MenuItem { title: @tr("Emboss…") + "      F S M"; activated => { App.action("fx:emboss"); } }
                MenuItem { title: @tr("Outline…") + "      F S O"; activated => { App.action("fx:outline"); } }
                MenuItem { title: @tr("Relief…") + "      F S R"; activated => { App.action("fx:relief"); } }
