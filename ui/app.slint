                MenuItem { title: "Frosted Glass…      F D F"; activated => { App.action("fx:frosted-glass"); } }
                MenuItem { title: "Pixelate…      F D P"; activated => { App.action("fx:pixelate"); } }
                MenuItem { title: "Polar Inversion…      F D I"; activated => { App.action("fx:polar-inversion"); } }
                MenuItem { title: "Tile Reflection…      F D T"; activated => { App.action("fx:tile-reflection"); } }
