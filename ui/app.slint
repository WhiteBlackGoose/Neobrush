import { Palette } from "std-widgets.slint";
export { Palette }
export { App, Tip, Tool, Theme, LayerItem, HistoryItem, DocTab, ParamItem, CurvePoint }
export { Seg, PaletteItem, ChordOption, ShortcutRow, LangItem } from "state.slint";

component DocTabs inherits Rectangle {
    height: 44px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for tab[i] in App.tabs: Rectangle {
            height: 40px;
            y: 2px;
            width: min(220px, row.preferred-width);
            border-radius: 9px;
            background: tab.active ? Theme.surface : tta.has-hover ? Theme.hover : transparent;
            border-width: tab.active ? 1px : 0px;
            border-color: Theme.border;
            drop-shadow-blur: tab.active ? 8px : 0px;
            drop-shadow-color: Theme.shadow;
            tta := TouchArea {
                clicked => { App.tab-select(i); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
                        App.tab-close(i);
                    }
                }
            }
            row := HorizontalLayout {
                padding-left: 5px;
                padding-right: 4px;
                spacing: 8px;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    y: 5px;
                    border-radius: 5px;
                    clip: true;
                    border-width: 1px;
                    border-color: Theme.border;
                    Image {
                        source: tab.thumb;
                        width: parent.width;
                        height: parent.height;
                        image-fit: contain;
                    }
                }
                Text {
                    text: tab.title + (tab.modified ? " •" : "");
                    font-size: Theme.font;
                    font-weight: tab.active ? 600 : 500;
                    color: tab.active ? Theme.text : Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 140px;
                }
                IconButton {
                    y: 9px;
                    size: 22px;
                    icon-size: 12px;
                    icon: Icons.x;
                    tip: @tr("Close") + "  Ctrl+W";
                    clicked => { App.tab-close(i); }
                }
            }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 28px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 18px;
        Text {
            text: App.status-hint;
            color: Theme.text-muted;
            font-size: Theme.font-sm + 0.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if App.status-sel != "": HorizontalLayout {
            spacing: 6px;
            Image { source: Icons.square-dashed; width: 12px; height: 12px; y: 8px; colorize: Theme.text-faint; }
            Text { text: App.status-sel; color: Theme.text-muted; font-size: Theme.font-sm + 0.5px; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 6px;
            Image { source: Icons.pointer; width: 12px; height: 12px; y: 8px; colorize: Theme.text-faint; }
            Text { text: App.status-pos; color: Theme.text-muted; font-size: Theme.font-sm + 0.5px; vertical-alignment: center; min-width: 70px; }
        }
        HorizontalLayout {
            spacing: 6px;
            Image { source: Icons.image; width: 12px; height: 12px; y: 8px; colorize: Theme.text-faint; }
            Text { text: App.status-size; color: Theme.text-muted; font-size: Theme.font-sm + 0.5px; vertical-alignment: center; }
        }
        Rectangle {
            width: donate.preferred-width;
            donate := HorizontalLayout {
                spacing: 5px;
                Image {
                    source: @image-url("icons/heart.svg");
                    width: 12px;
                    height: 12px;
                    y: 8px;
                    colorize: dta.has-hover ? #f43f5e : Theme.text-faint;
                }
                Text {
                    text: @tr("Support Ukraine's children");
                    color: dta.has-hover ? Theme.text : Theme.text-faint;
                    font-size: Theme.font-sm + 0.5px;
                    vertical-alignment: center;
                }
            }
            dta := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.action("help.donate"); }
                changed has-hover => {
                    if self.has-hover {
                        Tip.show(@tr("Donate to Voices of Children · voices.org.ua"), self.absolute-position.x - 100px, self.absolute-position.y - 30px);
                    } else {
                        Tip.hide();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
