            MenuItem { title: "Pixel Grid      V G"; checkable: true; checked: App.pixel-grid; activated => { App.action("view.grid"); } }
            MenuItem { title: "Rulers"; shortcut: @keys(Control + Alt + R); checkable: true; checked: App.show-rulers; activated => { App.action("view.rulers"); } }
            MenuSeparator { }
            MenuItem { title: "Tools Panel      V 1"; checkable: true; checked: App.show-tools; activated => { App.action("view.panel-tools"); } }
            MenuItem { title: "Colors Panel      V 2"; checkable: true; checked: App.show-colors; activated => { App.action("view.panel-colors"); } }
            MenuItem { title: "Layers Panel      V 3"; checkable: true; checked: App.show-layers; activated => { App.action("view.panel-layers"); } }
            MenuItem { title: "History Panel      V 4"; checkable: true; checked: App.show-history; activated => { App.action("view.panel-history"); } }
        }
        Menu {
            title: "Image";
            MenuItem { title: "Crop to Selection"; shortcut: @keys(Control + Shift + X); enabled: App.has-selection; activated => { App.action("image.crop"); } }
