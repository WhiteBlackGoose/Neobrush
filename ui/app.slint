            MenuItem { title: "Ellipse Select      S"; activated => { App.action("tool:ellipse-select"); } }
            MenuItem { title: "Lasso Select      S"; activated => { App.action("tool:lasso-select"); } }
            MenuItem { title: "Magic Wand      S"; activated => { App.action("tool:magic-wand"); } }
            MenuItem { title: "Move Selected Pixels      M"; activated => { App.action("tool:move-pixels"); } }
            MenuItem { title: "Move Selection      M"; activated => { App.action("tool:move-selection"); } }
            MenuSeparator { }
            MenuItem { title: "Paintbrush      B"; activated => { App.action("tool:brush"); } }
            MenuItem { title: "Pencil      P"; activated => { App.action("tool:pencil"); } }
            MenuItem { title: "Eraser      E"; activated => { App.action("tool:eraser"); } }
            MenuItem { title: "Gradient      G"; activated => { App.action("tool:gradient"); } }
            MenuItem { title: "Paint Bucket      G"; activated => { App.action("tool:bucket"); } }
            MenuItem { title: "Color Picker      K"; activated => { App.action("tool:picker"); } }
            MenuItem { title: "Clone Stamp      C"; activated => { App.action("tool:clone"); } }
            MenuItem { title: "Recolor      R"; activated => { App.action("tool:recolor"); } }
            MenuSeparator { }
            MenuItem { title: "Text      T"; activated => { App.action("tool:text"); } }
            MenuItem { title: "Line / Curve      O"; activated => { App.action("tool:line"); } }
            MenuItem { title: "Shapes      O"; activated => { App.action("tool:shape"); } }
            MenuSeparator { }
            MenuItem { title: "Pan      H"; activated => { App.action("tool:pan"); } }
            MenuItem { title: "Zoom      Z"; activated => { App.action("tool:zoom"); } }
