                MenuItem { title: "Glow…      F P G"; activated => { App.action("fx:glow"); } }
                MenuItem { title: "Red Eye Removal…      F P R"; activated => { App.action("fx:red-eye"); } }
                MenuItem { title: "Sharpen…      F P S"; activated => { App.action("fx:sharpen"); } }
                MenuItem { title: "Soft Portrait…      F P P"; activated => { App.action("fx:soft-portrait"); } }
