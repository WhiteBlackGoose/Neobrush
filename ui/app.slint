    icon: @image-url("icons/app-icon.svg");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: App.ui-font;
    default-font-size: 12.5px;

