            MenuSeparator { }
            MenuItem { title: @tr("Paintbrush") + "      B"; activated => { App.action("tool:brush"); } }
            MenuItem { title: @tr("Pencil") + "      P"; activated => { App.action("tool:pencil"); } }
            MenuItem { title: @tr("Eraser") + "      E"; activated => { App.action("tool:eraser"); } }
            MenuItem { title: @tr("Gradient") + "      G"; activated => { App.action("tool:gradient"); } }
            MenuItem { title: @tr("Paint Bucket") + "      G"; activated => { App.action("tool:bucket"); } }
            MenuItem { title: @tr("Color Picker") + "      K"; activated => { App.action("tool:picker"); } }
            MenuItem { title: @tr("Clone Stamp") + "      C"; activated => { App.action("tool:clone"); } }
            MenuItem { title: @tr("Recolor") + "      R"; activated => { App.action("tool:recolor"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Text") + "      T"; activated => { App.action("tool:text"); } }
            MenuItem { title: @tr("Line / Curve") + "      O"; activated => { App.action("tool:line"); } }
            MenuItem { title: @tr("Shapes") + "      O"; activated => { App.action("tool:shape"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Pan") + "      H"; activated => { App.action("tool:pan"); } }
            MenuItem { title: @tr("Zoom") + "      Z"; activated => { App.action("tool:zoom"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Swap Colors") + "      X"; activated => { App.action("color.swap"); } }
            MenuItem { title: @tr("Reset Colors") + "      D"; activated => { App.action("color.reset"); } }
            MenuItem { title: @tr("Smaller Brush") + "      ["; activated => { App.action("brush.smaller"); } }
            MenuItem { title: @tr("Bigger Brush") + "      ]"; activated => { App.action("brush.bigger"); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("Keyboard Shortcuts"); shortcut: @keys(F1); activated => { App.action("help.shortcuts"); } }
            MenuItem { title: @tr("About Neobrush"); shortcut: @keys(Shift + F1); activated => { App.action("help.about"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Source Code on GitHub"); activated => { App.action("help.github"); } }
            MenuItem { title: @tr("Donate to Voices of Children"); activated => { App.action("help.donate"); } }
