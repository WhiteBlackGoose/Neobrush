            MenuItem { title: @tr("Settings…"); shortcut: @keys(Control + ","); activated => { App.action("app.settings"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Close"); shortcut: @keys(Control + W); activated => { App.action("file.close"); } }
            MenuItem { title: @tr("Exit"); shortcut: @keys(Control + Q); enabled: !App.is-web; activated => { App.action("file.exit"); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); shortcut: @keys(Control + Z); activated => { App.action("edit.undo"); } }
            MenuItem { title: @tr("Redo"); shortcut: @keys(Control + Y); activated => { App.action("edit.redo"); } }
