            MenuItem { title: "Swap Colors      X"; activated => { App.action("color.swap"); } }
            MenuItem { title: "Reset Colors      D"; activated => { App.action("color.reset"); } }
            MenuItem { title: "Smaller Brush      ["; activated => { App.action("brush.smaller"); } }
            MenuItem { title: "Bigger Brush      ]"; activated => { App.action("brush.bigger"); } }
