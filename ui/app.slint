    }
    // END GENERATED MENU

    VerticalLayout {
        TopBar { }
        Divider { }
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            if App.show-tools && App.has-doc: VerticalLayout {
                width: 232px;
                spacing: 10px;
                alignment: start;
                ToolPalette { }
                ToolOptions { }
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                if App.tabs.length > 0: DocTabs { }
                CanvasView {
                    vertical-stretch: 1;
                }
            }
            if App.has-doc && (App.show-colors || App.show-layers || App.show-history): VerticalLayout {
                width: 284px;
                spacing: 10px;
                if App.show-colors: ColorsPanel { }
                if App.show-layers: LayersPanel { vertical-stretch: 3; }
                if App.show-history: HistoryPanel { vertical-stretch: 2; }
            }
        }
        StatusBar { }
    }

    if App.dialog == "new": NewImageDialog { }
    if App.dialog == "resize": ResizeDialog { }
    if App.dialog == "canvas": CanvasSizeDialog { }
    if App.dialog == "fx": FxDialog { }
    if App.dialog == "curves": CurvesDialog { }
    if App.dialog == "layer-props": LayerPropsDialog { }
    if App.dialog == "confirm": ConfirmDialog { }
    if App.dialog == "message": MessageDialog { }
    if App.dialog == "jpeg": JpegDialog { }
    if App.dialog == "about": AboutDialog { }
    if App.dialog == "shortcuts": ShortcutsDialog { }
    if App.dialog == "export": ExportDialog { }
    if App.dialog == "palette": PaletteDialog { }
    if App.dialog == "settings": SettingsDialog { }

    if App.chord-active: ChordHud {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 44px;
    }

    // Tooltip layer
    if Tip.shown: Rectangle {
        x: min(Tip.x, root.width - self.width - 4px);
        y: Tip.y;
        width: tt.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: Theme.dark ? #f0f0f5 : #1f2029;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000044;
        tt := Text {
            text: Tip.text;
            color: Theme.dark ? #15151a : #f5f5fa;
            font-size: Theme.font-sm + 0.5px;
            font-weight: 500;
        }
    }
}
