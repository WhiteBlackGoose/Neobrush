import "fonts/Inter-400.ttf";
import "fonts/Inter-500.ttf";
import "fonts/Inter-600.ttf";

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, Tip, Tool, LayerItem, HistoryItem, DocTab, ParamItem, CurvePoint } from "state.slint";
import { IconButton, Divider, VDivider, Card } from "widgets.slint";
import { ToolPalette, ColorsPanel, LayersPanel, HistoryPanel } from "panels.slint";
import { TopBar, ToolOptions } from "toolbar.slint";
import { CanvasView } from "canvas.slint";
import { PaletteDialog, ChordHud } from "palette.slint";
import { NewImageDialog, ResizeDialog, CanvasSizeDialog, FxDialog, CurvesDialog, LayerPropsDialog, ConfirmDialog, MessageDialog, JpegDialog, AboutDialog, ShortcutsDialog, ExportDialog } from "dialogs.slint";

import { Palette } from "std-widgets.slint";
export { Palette }
export { App, Tip, Tool, Theme, LayerItem, HistoryItem, DocTab, ParamItem, CurvePoint }
export { Seg, PaletteItem, ChordOption, ShortcutRow } from "state.slint";

component DocTabs inherits Rectangle {
    height: 44px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for tab[i] in App.tabs: Rectangle {
            height: 40px;
            y: 2px;
            width: min(220px, row.preferred-width);
            border-radius: 9px;
            background: tab.active ? Theme.surface : tta.has-hover ? Theme.hover : transparent;
            border-width: tab.active ? 1px : 0px;
            border-color: Theme.border;
            drop-shadow-blur: tab.active ? 8px : 0px;
            drop-shadow-color: Theme.shadow;
            tta := TouchArea {
                clicked => { App.tab-select(i); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.middle {
                        App.tab-close(i);
                    }
                }
            }
            row := HorizontalLayout {
                padding-left: 5px;
                padding-right: 4px;
                spacing: 8px;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    y: 5px;
                    border-radius: 5px;
                    clip: true;
                    border-width: 1px;
                    border-color: Theme.border;
                    Image {
                        source: tab.thumb;
                        width: parent.width;
                        height: parent.height;
                        image-fit: contain;
                    }
                }
                Text {
                    text: tab.title + (tab.modified ? " •" : "");
                    font-size: Theme.font;
                    font-weight: tab.active ? 600 : 500;
                    color: tab.active ? Theme.text : Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 140px;
                }
                IconButton {
                    y: 9px;
                    size: 22px;
                    icon-size: 12px;
                    icon: Icons.x;
                    tip: "Close  Ctrl+W";
                    clicked => { App.tab-close(i); }
                }
            }
        }
    }
}

component StatusBar inherits Rectangle {
    height: 28px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 18px;
        Text {
            text: App.status-hint;
            color: Theme.text-muted;
            font-size: Theme.font-sm + 0.5px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if App.status-sel != "": HorizontalLayout {
            spacing: 6px;
            Image { source: Icons.square-dashed; width: 12px; height: 12px; y: 8px; colorize: Theme.text-faint; }
            Text { text: App.status-sel; color: Theme.text-muted; font-size: Theme.font-sm + 0.5px; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 6px;
            Image { source: Icons.pointer; width: 12px; height: 12px; y: 8px; colorize: Theme.text-faint; }
            Text { text: App.status-pos; color: Theme.text-muted; font-size: Theme.font-sm + 0.5px; vertical-alignment: center; min-width: 70px; }
        }
        HorizontalLayout {
            spacing: 6px;
            Image { source: Icons.image; width: 12px; height: 12px; y: 8px; colorize: Theme.text-faint; }
            Text { text: App.status-size; color: Theme.text-muted; font-size: Theme.font-sm + 0.5px; vertical-alignment: center; }
        }
        Rectangle {
            width: donate.preferred-width;
            donate := HorizontalLayout {
                spacing: 5px;
                Image {
                    source: @image-url("icons/heart.svg");
                    width: 12px;
                    height: 12px;
                    y: 8px;
                    colorize: dta.has-hover ? #f43f5e : Theme.text-faint;
                }
                Text {
                    text: "Support Ukraine's children";
                    color: dta.has-hover ? Theme.text : Theme.text-faint;
                    font-size: Theme.font-sm + 0.5px;
                    vertical-alignment: center;
                }
            }
            dta := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.action("help.donate"); }
                changed has-hover => {
                    if self.has-hover {
                        Tip.show("Donate to Voices of Children · voices.org.ua", self.absolute-position.x - 100px, self.absolute-position.y - 30px);
                    } else {
                        Tip.hide();
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: App.window-title;
    icon: @image-url("icons/app-icon.svg");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Inter";
    default-font-size: 12.5px;

    // BEGIN GENERATED MENU (tools/gen_commands.py)
    MenuBar {
        visible: App.show-menubar;
        Menu {
            title: "File";
            MenuItem { title: "New…"; shortcut: @keys(Control + N); activated => { App.action("file.new"); } }
            MenuItem { title: "Open…"; shortcut: @keys(Control + O); activated => { App.action("file.open"); } }
            Menu {
                title: "Open Recent";
                enabled: App.recent-files.length > 0;
                for f in App.recent-files: MenuItem {
                    title: f;
                    activated => { App.action("file.recent:" + f); }
                }
                MenuSeparator { }
                MenuItem { title: "Clear Recent"; activated => { App.action("file.clear-recent"); } }
            }
            MenuSeparator { }
            MenuItem { title: "Save"; shortcut: @keys(Control + S); activated => { App.action("file.save"); } }
            MenuItem { title: "Save As…"; shortcut: @keys(Control + Shift + S); activated => { App.action("file.save-as"); } }
            MenuSeparator { }
            MenuItem { title: "Close"; shortcut: @keys(Control + W); activated => { App.action("file.close"); } }
            MenuItem { title: "Exit"; shortcut: @keys(Control + Q); enabled: !App.is-web; activated => { App.action("file.exit"); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; shortcut: @keys(Control + Z); activated => { App.action("edit.undo"); } }
            MenuItem { title: "Redo"; shortcut: @keys(Control + Y); activated => { App.action("edit.redo"); } }
            MenuSeparator { }
            MenuItem { title: "Cut"; shortcut: @keys(Control + X); activated => { App.action("edit.cut"); } }
            MenuItem { title: "Copy"; shortcut: @keys(Control + C); activated => { App.action("edit.copy"); } }
            MenuItem { title: "Copy Merged"; shortcut: @keys(Control + Shift + C); activated => { App.action("edit.copy-merged"); } }
            MenuItem { title: "Paste"; shortcut: @keys(Control + V); activated => { App.action("edit.paste"); } }
            MenuItem { title: "Paste into New Layer"; shortcut: @keys(Control + Shift + V); activated => { App.action("edit.paste-new-layer"); } }
            MenuItem { title: "Paste into New Image"; shortcut: @keys(Control + Alt + V); activated => { App.action("edit.paste-new-image"); } }
            MenuSeparator { }
            MenuItem { title: "Select All"; shortcut: @keys(Control + A); activated => { App.action("edit.select-all"); } }
            MenuItem { title: "Deselect"; shortcut: @keys(Control + D); activated => { App.action("edit.deselect"); } }
            MenuItem { title: "Invert Selection"; shortcut: @keys(Control + I); activated => { App.action("edit.invert-selection"); } }
            MenuSeparator { }
            MenuItem { title: "Erase Selection      Delete"; activated => { App.action("edit.erase"); } }
            MenuItem { title: "Fill Selection      Backspace"; activated => { App.action("edit.fill"); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Command Palette…      Space"; activated => { App.action("palette.open"); } }
            MenuItem { title: "Menu Bar      V M"; checkable: true; checked: App.show-menubar; activated => { App.action("view.menubar"); } }
            MenuSeparator { }
            MenuItem { title: "Zoom In"; shortcut: @keys(Control + Plus); activated => { App.action("view.zoom-in"); } }
            MenuItem { title: "Zoom Out"; shortcut: @keys(Control + HyphenMinus); activated => { App.action("view.zoom-out"); } }
            MenuItem { title: "Zoom to Window"; shortcut: @keys(Control + B); activated => { App.action("view.fit"); } }
            MenuItem { title: "Actual Size"; shortcut: @keys(Control + "0"); activated => { App.action("view.actual"); } }
            MenuSeparator { }
            Menu {
                title: "Theme";
                MenuItem { title: "Follow System      V T S"; checkable: true; checked: App.theme-mode == 0; activated => { App.action("view.theme-system"); } }
                MenuItem { title: "Light      V T L"; checkable: true; checked: App.theme-mode == 1; activated => { App.action("view.theme-light"); } }
                MenuItem { title: "Dark      V T D"; checkable: true; checked: App.theme-mode == 2; activated => { App.action("view.theme-dark"); } }
            }
