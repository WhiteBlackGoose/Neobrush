            MenuItem { title: "Flip Layer Vertical      L V"; activated => { App.action("layer.flip-v"); } }
            MenuItem { title: "Rotate / Zoom…"; shortcut: @keys(Control + Shift + Z); activated => { App.action("fx:rotate-zoom"); } }
            MenuSeparator { }
