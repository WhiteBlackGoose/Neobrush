                title: "Artistic";
                MenuItem { title: "Ink Sketch…      F A I"; activated => { App.action("fx:ink-sketch"); } }
                MenuItem { title: "Oil Painting…      F A O"; activated => { App.action("fx:oil-painting"); } }
                MenuItem { title: "Pencil Sketch…      F A P"; activated => { App.action("fx:pencil-sketch"); } }
            }
            Menu {
                title: "Blurs";
                MenuItem { title: "Fragment…      F B F"; activated => { App.action("fx:fragment"); } }
                MenuItem { title: "Gaussian Blur…      F B G"; activated => { App.action("fx:gaussian-blur"); } }
                MenuItem { title: "Motion Blur…      F B M"; activated => { App.action("fx:motion-blur"); } }
                MenuItem { title: "Radial Blur…      F B R"; activated => { App.action("fx:radial-blur"); } }
