            }
            Menu {
                title: "Render";
                MenuItem { title: "Clouds…      F R C"; activated => { App.action("fx:clouds"); } }
                MenuItem { title: "Julia Fractal…      F R J"; activated => { App.action("fx:julia"); } }
                MenuItem { title: "Mandelbrot Fractal…      F R M"; activated => { App.action("fx:mandelbrot"); } }
            }
