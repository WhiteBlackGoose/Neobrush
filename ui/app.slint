            MenuItem { title: @tr("Cut"); shortcut: @keys(Control + X); activated => { App.action("edit.cut"); } }
            MenuItem { title: @tr("Copy"); shortcut: @keys(Control + C); activated => { App.action("edit.copy"); } }
            MenuItem { title: @tr("Copy Merged"); shortcut: @keys(Control + Shift + C); activated => { App.action("edit.copy-merged"); } }
            MenuItem { title: @tr("Paste"); shortcut: @keys(Control + V); activated => { App.action("edit.paste"); } }
            MenuItem { title: @tr("Paste into New Layer"); shortcut: @keys(Control + Shift + V); activated => { App.action("edit.paste-new-layer"); } }
            MenuItem { title: @tr("Paste into New Image"); shortcut: @keys(Control + Alt + V); activated => { App.action("edit.paste-new-image"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Select All"); shortcut: @keys(Control + A); activated => { App.action("edit.select-all"); } }
            MenuItem { title: @tr("Deselect"); shortcut: @keys(Control + D); activated => { App.action("edit.deselect"); } }
            MenuItem { title: @tr("Invert Selection"); shortcut: @keys(Control + I); activated => { App.action("edit.invert-selection"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Erase Selection") + "      Delete"; activated => { App.action("edit.erase"); } }
            MenuItem { title: @tr("Fill Selection") + "      Backspace"; activated => { App.action("edit.fill"); } }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Command Palette…") + "      Space"; activated => { App.action("palette.open"); } }
            MenuItem { title: @tr("Menu Bar") + "      V M"; checkable: true; checked: App.show-menubar; activated => { App.action("view.menubar"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Zoom In"); shortcut: @keys(Control + Plus); activated => { App.action("view.zoom-in"); } }
