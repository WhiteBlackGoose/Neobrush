            MenuItem { title: "Curves…"; shortcut: @keys(Control + Shift + M); activated => { App.action("fx:curves"); } }
            MenuItem { title: "Hue / Saturation…"; shortcut: @keys(Control + Shift + U); activated => { App.action("fx:hue-saturation"); } }
            MenuItem { title: "Invert Colors"; shortcut: @keys(Control + Shift + I); activated => { App.action("fx:invert-colors"); } }
            MenuItem { title: "Levels…"; shortcut: @keys(Control + L); activated => { App.action("fx:levels"); } }
            MenuItem { title: "Posterize…"; shortcut: @keys(Control + Shift + P); activated => { App.action("fx:posterize"); } }
            MenuItem { title: "Sepia"; shortcut: @keys(Control + Shift + E); activated => { App.action("fx:sepia"); } }
            MenuSeparator { }
            MenuItem { title: "Vibrance…      A V"; activated => { App.action("fx:vibrance"); } }
            MenuItem { title: "Temperature / Tint…      A T"; activated => { App.action("fx:temperature"); } }
        }
