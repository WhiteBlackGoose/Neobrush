                MenuItem { title: @tr("Bulge…") + "      F D B"; activated => { App.action("fx:bulge"); } }
                MenuItem { title: @tr("Dents…") + "      F D D"; activated => { App.action("fx:dents"); } }
                MenuItem { title: @tr("Frosted Glass…") + "      F D F"; activated => { App.action("fx:frosted-glass"); } }
                MenuItem { title: @tr("Pixelate…") + "      F D P"; activated => { App.action("fx:pixelate"); } }
                MenuItem { title: @tr("Polar Inversion…") + "      F D I"; activated => { App.action("fx:polar-inversion"); } }
                MenuItem { title: @tr("Tile Reflection…") + "      F D T"; activated => { App.action("fx:tile-reflection"); } }
                MenuItem { title: @tr("Twist…") + "      F D W"; activated => { App.action("fx:twist"); } }
